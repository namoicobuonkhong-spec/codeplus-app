# Sao chép thành .env rồi điền cấu hình Firebase (Project settings → Your apps → Web app → Config).
# Để trống thì app chạy chế độ thử.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
