{
  "expo": {
    "name": "codeplus Thi",
    "slug": "codeplus-thi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codeplusthi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.edu.hvt.codeplus",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Xác nhận phát đề bằng Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.edu.hvt.codeplus",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E6B4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Xác nhận phát đề bằng Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}